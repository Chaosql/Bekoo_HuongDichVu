# Copy to .env and fill in credentials. Safe to commit this example.
# Addresses below assume containers use the root Compose network.

# MySQL: matches ${db.url}, ${db.user}, ${db.password} in Command.
MYSQL_DATABASE=booking_care_command
MYSQL_ROOT_PASSWORD=
DB_URL=jdbc:mysql://mysql:3306/booking_care_command?createDatabaseIfNotExist=true
DB_USER=root
DB_PASSWORD=

# Kafka: Command uses kafka.port; Query uses kafka.server.
KAFKA_PORT=kafka:9092
KAFKA_SERVER=kafka:9092

# Redis: used by the custom RedisConfig in both services.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch: matches Query's elastic.* properties.
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=
ELASTIC_URIS=http://elasticsearch:9200

# Mail: use the mail provider's SMTP credential/app password.
MAIL_USER=
MAIL_PASSWORD=

# Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# API endpoints and frontend.
COMMAND_SERVER_PORT=8080
QUERY_SERVER_PORT=8081
SERVER_ADDRESS=0.0.0.0
COMMAND_PUBLIC_URL=http://localhost:8083
QUERY_PUBLIC_URL=http://localhost:8084
WEB_URL=http://localhost:8082/home

# VNPay: use sandbox credentials for testing.
VNPAY_RETURN_URL=http://localhost:8083/payment/result
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=

# JWT: both services must use the same Base64-encoded secret.
JWT_SECRET=

# Initial admin: leave email/password empty to skip account creation.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị hệ thống
ADMIN_CCCD=
ADMIN_PHONE=
ADMIN_PROVINCE=
ADMIN_DISTRICT=
ADMIN_COMMUNE=
# YYYY-MM-DD; required with the other profile fields when creating an admin.
ADMIN_DOB=
ADMIN_GENDER=

# Root Docker Compose reads .env and maps the per-service ports and URLs.
# Spring Boot launched directly still needs environment variables exported.
# When using local MySQL as root, DB_PASSWORD must equal MYSQL_ROOT_PASSWORD.
# Database passwords in an existing volume are not changed by editing .env.
