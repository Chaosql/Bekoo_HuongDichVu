# Replace both domains. Install in /etc/nginx/conf.d/bekoo.conf.
map $http_upgrade $bekoo_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name bekoo-command.chiikaiwa.me;
    client_max_body_size 12m;
    location = /actuator { deny all; }
    location ^~ /actuator/ { deny all; }
    location / {
        proxy_pass http://127.0.0.1:8083;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $bekoo_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
server {
    listen 80;
    server_name bekoo-query.chiikaiwa.me;
    location = /actuator { deny all; }
    location ^~ /actuator/ { deny all; }
    location / {
        proxy_pass http://127.0.0.1:8084;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $bekoo_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
